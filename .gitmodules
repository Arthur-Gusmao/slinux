[submodule "userland/limine"]
	path = userland/limine
	url = https://github.com/limine-bootloader/limine.git
[submodule "userland/smdev"]
	path = userland/smdev
	url = git@github.com:Arthur-Gusmao/smdev.git
	ignore = all
[submodule "userland/nldev"]
	path = userland/nldev
	url = git@github.com:Arthur-Gusmao/nldev.git
	ignore = all
[submodule "userland/svc"]
	path = userland/svc
	url = git@github.com:Arthur-Gusmao/svc.git
	ignore = all
[submodule "userland/sup"]
	path = userland/sup
	url = git@github.com:Arthur-Gusmao/sup.git
	ignore = all
[submodule "userland/curl"]
	path = userland/curl
