#!/bin/sh
# slinux boot script, spawned by sinit(8)

export PATH=/bin

# stage markers go both to the console and to /dev/kmsg so that tools
# like netconsole(8) can capture userspace boot progress remotely
echo2() {
	echo "$*"
	echo "<7>slinux-init: $*" > /dev/kmsg 2>/dev/null
}

# slinux_trace on the kernel cmdline turns on shell tracing, printing
# every command to the console as it runs
case $(cat /proc/cmdline) in
*slinux_trace*) set -x ;;
esac

echo2 "Starting slinux..."

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sys /sys
mountpoint -q /dev  || mount -t devtmpfs dev /dev

# device nodes: coldplug scan of sysfs, then the nldev(8) daemon feeds
# hotplug uevents to smdev(8) for new devices
if [ -x /bin/smdev ]; then
	smdev -s
	[ -x /bin/nldev ] && nldev -r /bin/smdev -b
fi

mkdir -p /var/run /var/log /mnt
chmod 1777 /tmp

# disk-root mode: booted with root=... pointing at a real filesystem.
# the live system (initramfs) mounts it and switch_root(8)s into it; on
# an installed system /.slinux-installed exists and this step is skipped.
# root= accepts /dev/node, PARTUUID=<gpt uuid> or UUID=<filesystem uuid>.
ROOT=
for p in $(cat /proc/cmdline); do
	case $p in root=*) ROOT=${p#root=} ;; esac
done

resolve_root() {
	kind=$1 want=$2
	: >/tmp/.rootdev
	for d in /sys/block/*; do
		dev=${d##*/}
		case $dev in loop* | ram* | sr* | fd* | dm-* | zram*) continue ;; esac
		sfdisk -d /dev/$dev 2>/dev/null | while IFS= read -r line; do
			case $line in
			/dev/*) ;;
			*) continue ;;
			esac
			part=${line%% *}
			uuid=${line##*uuid=}
			uuid=${uuid%%,*}
			if [ "$uuid" = "$want" ]; then
				if [ "$kind" = partuuid ] || tune2fs -l "$part" 2>/dev/null |
					grep -qi "filesystem uuid.*$want"; then
					echo "$part" >>/tmp/.rootdev
				fi
			fi
			done
	done
	[ -s /tmp/.rootdev ] && { read -r ROOT </tmp/.rootdev; return 0; }
	return 1
}

if [ -n "$ROOT" ] && [ ! -e /.slinux-installed ]; then
	case $ROOT in
	PARTUUID=*) resolve_root partuuid "${ROOT#PARTUUID=}" || {
		echo "slinux: no partition with ${ROOT}, dropping to shell"
		exec /bin/sh
	} ;;
	UUID=*) resolve_root uuid "${ROOT#UUID=}" || {
		echo "slinux: no filesystem with ${ROOT}, dropping to shell"
		exec /bin/sh
	} ;;
	esac
	fsck.ext4 -p "$ROOT"
	mkdir -p /newroot
	mount -t ext4 "$ROOT" /newroot || {
		echo "slinux: cannot mount root=$ROOT, dropping to shell"
		exec /bin/sh
	}
	touch /newroot/.slinux-installed
	mount --move /proc  /newroot/proc  || mount -t proc proc /newroot/proc
	mount --move /sys   /newroot/sys   || mount -t sysfs sys /newroot/sys
	mount --move /dev   /newroot/dev   || mount -t devtmpfs dev /newroot/dev
	echo "slinux: switching to real root $ROOT"
	exec switch_root /newroot /bin/init
fi

# system logging (syslogd(8) daemonizes)
echo2 "syslog, hostname"
syslogd

hostname "$(cat /etc/hostname)"

# network: loopback, then dhcp on the wired interface. sdhcp(8) only
# daemonizes after obtaining a lease and retries forever, so it must
# never run in the foreground or boot would block without a dhcp
# server (it also writes /etc/resolv.conf once bound)
ifconfig lo 127.0.0.1 up
ifconfig eth0 up
(sdhcp eth0) >/dev/null 2>&1 &

# wifi: join networks listed in /etc/wpa_supplicant.conf, if any
if [ -f /etc/wpa_supplicant.conf ]; then
	for wl in /sys/class/net/wlan*; do
		[ -d "$wl" ] || continue
		if=${wl#/sys/class/net/}
		wpa_supplicant -B -i "$if" -c /etc/wpa_supplicant.conf
		(sdhcp "$if") >/dev/null 2>&1 &
	done
fi

# ssh server via svc(8): -R generates host keys on first connection.
# note: password auth requires a non-empty root password; set one with
# passwd(1) or install a public key in /root/.ssh/authorized_keys
echo2 "ssh"
if [ -x /bin/svc ] && [ -e /bin/svc.d/avail/dropbear ]; then
	mkdir -p /etc/dropbear /root/.ssh
	chmod 700 /root/.ssh
	svc -s dropbear
elif [ -x /bin/dropbear ]; then
	mkdir -p /etc/dropbear /root/.ssh
	chmod 700 /root/.ssh
	dropbear -R
fi

cat /etc/motd

# site-specific customization hook (wifi, extra daemons, ...)
[ -x /etc/rc.local ] && /etc/rc.local

echo2 "console login"
respawn getty /dev/ttyS0 linux &
respawn getty /dev/tty1 linux &
