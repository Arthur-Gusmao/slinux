#!/bin/sh
# slinux boot script, spawned by sinit(8)

export PATH=/bin

echo "Starting slinux..."

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sys /sys
mountpoint -q /dev  || mount -t devtmpfs dev /dev

mkdir -p /var/run /var/log
chmod 1777 /tmp

hostname "$(cat /etc/hostname)"

# network: loopback, then dhcp on the wired interface (sdhcp(8)
# daemonizes and renews the lease; it also writes /etc/resolv.conf)
ifconfig lo 127.0.0.1 up
ifconfig eth0 up
sdhcp eth0

cat /etc/motd

# console login, restarted automatically if the shell exits
respawn getty /dev/ttyS0 linux &
respawn getty /dev/tty1 linux &
