# slinux kernel config - Oasis style minimal
# Based on Oasis qemu config + slinux requirements
# Uses allnoconfig base (like Oasis merge_config.sh -n)

# =============================================================================
# Core
# =============================================================================
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PREEMPT_NONE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_TIME_ACCOUNTING=y
CONFIG_BSD_PROCESS_ACCT=y
CONFIG_BSD_PROCESS_ACCT_V3=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# =============================================================================
# Modules (Oasis uses modules)
# =============================================================================
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_MODULE_SIG=n

# =============================================================================
# EFI/UEFI
# =============================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_EFI_BOOTLOADER_CONTROL=y
CONFIG_EFI_CAPSULE_LOADER=y
CONFIG_EFI_CAPSULE_LOADER_SLOT_INFO=y
CONFIG_EFI_CAPSULE_LOADER_IMAGE_AUTH=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="pnpacpi=off i8042.nopnp i8042.nomux=1 console=ttyS0 console=tty0"

# =============================================================================
# Initramfs
# =============================================================================
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# =============================================================================
# IPC
# =============================================================================
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y

# =============================================================================
# Filesystems
# =============================================================================
CONFIG_FS_IOMAP=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_CHILDREN=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"

CONFIG_FUSE_FS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# =============================================================================
# Block devices
# =============================================================================
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=16
CONFIG_BLK_DEV_RAM_SIZE=65536

# Virtio block
CONFIG_VIRTIO_BLK=y

# ATA
CONFIG_ATA=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# =============================================================================
# Network
# =============================================================================
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y

CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y

CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_NET_SCHED=y

CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y

# 9p for virtio
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NET_9P_FD=y

# =============================================================================
# Character devices
# =============================================================================
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y
CONFIG_LEGACY_PTY_COUNT=256

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

CONFIG_VIRTIO_CONSOLE=y

# =============================================================================
# Virtio
# =============================================================================
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET_9P_VIRTIO=y

# =============================================================================
# PCI
# =============================================================================
CONFIG_PCI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCIEPORTBUS=y

# =============================================================================
# Input
# =============================================================================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_SCREEN_X=1024
CONFIG_INPUT_MOUSEDEV_SCREEN_Y=768
CONFIG_VIRTIO_INPUT=y

# =============================================================================
# Graphics (minimal for console)
# =============================================================================
CONFIG_FB=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_VIRTIO_GPU=y

# =============================================================================
# Sound
# =============================================================================
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y

# =============================================================================
# ACPI
# =============================================================================
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_PROCFS=y

# =============================================================================
# Power management
# =============================================================================
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI_SLEEP=y

# =============================================================================
# CPU frequency
# =============================================================================
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y

# =============================================================================
# Executable formats
# =============================================================================
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y

# =============================================================================
# Security
# =============================================================================
CONFIG_SECURITY=y
CONFIG_SECURITY_WRITABLE_HOOKS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_LSM="capability,landlock"

# =============================================================================
# Cryptography
# =============================================================================
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_BLKCIPHER=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_RNG=y
CONFIG_CRYPTO_AKCIPHER=y
CONFIG_CRYPTO_KPP=y
CONFIG_CRYPTO_ACOMP=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_WORKQUEUE=y

CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_GCM=y

# =============================================================================
# Library
# =============================================================================
CONFIG_BITREVERSE=y
CONFIG_GENERIC_STRNCPY_FROM_USER=y
CONFIG_GENERIC_STRNLEN_USER=y
CONFIG_GENERIC_NET_UTILS=y
CONFIG_CRC32=y
CONFIG_CRC32_SLICEBY8=y
CONFIG_XXHASH=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_X86=y
CONFIG_XXHASH=y

# =============================================================================
# Kernel hacking (minimal)
# =============================================================================
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n

# =============================================================================
# Disable bloat
# =============================================================================
# No CONFIG_MODULE_SIG
# No CONFIG_DEBUG_KERNEL
# No CONFIG_DEBUG_INFO
# No CONFIG_KPROBES
# No CONFIG_FTRACE
# No CONFIG_PERF_EVENTS
# No CONFIG_KALLSYMS (keep for debugging)
# No sound beyond virtio
# No wireless
# No bluetooth
# No irda
# No appletalk
# No isdn
# No hamradio
# No can
# No raid
# No lvm
# No dm
# No nfs
# No cifs