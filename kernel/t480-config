# slinux kernel config - T480 minimal with modern hardware support
# Philosophy: minimal kernel, everything needed built-in, modules only for optional extras
# Based on Oasis style + T480 hardware requirements

# =============================================================================
# Core
# =============================================================================
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_TIME_ACCOUNTING=y

# =============================================================================
# Modules (minimal - only for truly optional stuff)
# =============================================================================
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_SRCVERSION_ALL=y
CONFIG_MODULE_SIG=n

# =============================================================================
# EFI/UEFI (for limine)
# =============================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_RUNTIME_MAP=y
CONFIG_CMDLINE_BOOL=n
CONFIG_CMDLINE="pnpacpi=off i8042.nopnp i8042.nomux=1 console=ttyS0 console=tty0"

# =============================================================================
# Initramfs (Unix philosophy: fs for mounting real root)
# =============================================================================
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# =============================================================================
# IPC
# =============================================================================
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CROSS_MEMORY_ATTACH=y

# =============================================================================
# Filesystems (everything needed built-in)
# =============================================================================
CONFIG_FS_IOMAP=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_CHILDREN=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

CONFIG_FUSE_FS=y

# =============================================================================
# Block devices
# =============================================================================
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=16
CONFIG_BLK_DEV_RAM_SIZE=65536

# NVMe (T480 SSD)
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# Virtio (QEMU)
CONFIG_VIRTIO_BLK=y

# ATA/SATA
CONFIG_ATA=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y

# =============================================================================
# Network (built-in for boot)
# =============================================================================
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y

CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# Intel Ethernet
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y

# WiFi (Intel iwlwifi for T480)
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLWIFI_DEBUGFS=n
CONFIG_IWLWIFI_DEVICE_TRACING=n
CONFIG_IWLWIFI_PCIE=y
CONFIG_IWLMVM=y
CONFIG_IWLWIFI_LEDS=y

# Virtio net
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y

# =============================================================================
# Character devices
# =============================================================================
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=y
CONFIG_LEGACY_PTY_COUNT=256

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_HW_RANDOM_VIRTIO=y

# =============================================================================
# Graphics (Intel i915 for T480 UHD 620)
# =============================================================================
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_TTM=y

# Intel graphics (T480 UHD 620 = Gen 8.5)
CONFIG_DRM_I915=y
CONFIG_DRM_I915_CAPTURE_ERROR=y
CONFIG_DRM_I915_COMPRESS_ERROR=y
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_I915_GVT=y
CONFIG_DRM_I915_GVT_KVMGT=y

# Framebuffer
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y

# =============================================================================
# Audio (Intel HDA for T480)
# =============================================================================
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_GENERIC=y
CONFIG_SND_HDA_CORE=y
CONFIG_SND_HDA_PREALLOC_SIZE=2048

# =============================================================================
# Input (TrackPoint, Trackpad, Keyboard)
# =============================================================================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_SCREEN_X=1024
CONFIG_INPUT_MOUSEDEV_SCREEN_Y=768

# ThinkPad TrackPoint/Trackpad
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_MOUSE_PS2_SMBUS=y

# RMI4 (Trackpad)
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_SMB=y

# =============================================================================
# ThinkPad specific
# =============================================================================
CONFIG_THINKPAD_ACPI=y
CONFIG_THINKPAD_ACPI_ALSA_SUPPORT=y
CONFIG_THINKPAD_ACPI_VIDEO=y
CONFIG_THINKPAD_ACPI_HOTKEY_POLL=y

# =============================================================================
# USB/Thunderbolt
# =============================================================================
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# Thunderbolt (T480 has TB3)
CONFIG_THUNDERBOLT=y
CONFIG_THUNDERBOLT_NET=y

# =============================================================================
# Webcam
# =============================================================================
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y

# =============================================================================
# PCI
# =============================================================================
CONFIG_PCI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCIEPORTBUS=y

# =============================================================================
# Virtio (QEMU)
# =============================================================================
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y

# =============================================================================
# ACPI/Power
# =============================================================================
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_PROCFS=y
CONFIG_ACPI_PROCFS_POWER=y
CONFIG_ACPI_SLEEP=y
CONFIG_ACPI_EC_DEBUGFS=n
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y

# =============================================================================
# CPU frequency
# =============================================================================
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_X86_INTEL_PSTATE=y

# =============================================================================
# EFI/UEFI
# =============================================================================
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFI_RUNTIME_WRAPPERS=y
CONFIG_EFI_RUNTIME_MAP=y

# =============================================================================
# IPC
# =============================================================================

# =============================================================================
# Executable formats
# =============================================================================
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_COREDUMP=y

# =============================================================================
# Security
# =============================================================================
CONFIG_SECURITY=y
CONFIG_SECURITY_WRITABLE_HOOKS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_LSM="capability,landlock"

# =============================================================================
# Cryptography
# =============================================================================
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_AES_NI_INTEL=y

# =============================================================================
# Library
# =============================================================================
CONFIG_BITREVERSE=y
CONFIG_GENERIC_STRNCPY_FROM_USER=y
CONFIG_GENERIC_STRNLEN_USER=y
CONFIG_GENERIC_NET_UTILS=y
CONFIG_CRC32=y
CONFIG_CRC32_SLICEBY8=y
CONFIG_XXHASH=y
CONFIG_ZLIB_INFLATE=y
CONFIG_ZLIB_DEFLATE=y
CONFIG_XZ_DEC=y
CONFIG_XZ_DEC_X86=y

# =============================================================================
# Disable bloat
# =============================================================================
# CONFIG_MODULES=y (only for truly optional)
# CONFIG_DEBUG_KERNEL=n
# CONFIG_DEBUG_INFO=n
# No wireless beyond iwlwifi
# No bluetooth
# No irda
# No appletalk
# No isdn
# No hamradio
# No can
# No raid
# No lvm
# No dm
# No nfs
# No cifs
# No sound beyond HDA
# No DRM beyond i915